{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omics-skills.example/schemas/read-sample-sheet-row.json",
  "title": "Read sample-sheet row",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "read_type", "read1", "read2", "reference"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "read_type": {"enum": ["paired_short", "single_short", "long"]},
    "read1": {"type": "string", "minLength": 1},
    "read2": {"type": "string"},
    "reference": {"type": "string"}
  }
}
