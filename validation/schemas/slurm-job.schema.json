{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fmschulz/omics-skills/validation/schemas/slurm-job.schema.json",
  "title": "Scheduler-backed omics validation job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "validation_id", "driver", "truth_set_id",
    "workdir", "logs_dir", "scheduler", "environment", "databases",
    "version_commands", "command", "expected_outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["draft", "ready"]},
    "validation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "driver": {"type": "string", "pattern": "^bio-[a-z0-9-]+$"},
    "truth_set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "workdir": {"type": "string", "minLength": 1},
    "logs_dir": {"type": "string", "minLength": 1},
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "account", "partition", "qos", "cpus", "memory_mb", "time_minutes"],
      "properties": {
        "cluster": {"type": "string", "minLength": 1},
        "account": {"type": "string", "minLength": 1},
        "partition": {"type": "string", "minLength": 1},
        "qos": {"type": "string", "minLength": 1},
        "cpus": {"type": "integer", "minimum": 1},
        "memory_mb": {"type": "integer", "minimum": 128},
        "time_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "environment": {"$ref": "#/$defs/resource"},
    "databases": {
      "type": "array",
      "items": {"$ref": "#/$defs/resource"}
    },
    "version_commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "command": {"$ref": "#/$defs/command"},
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "min_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "min_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "kind", "path", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "directory"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^(TBD|[0-9a-f]{64})$"}
      }
    }
  }
}
